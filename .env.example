# ---------------------------------------------------------------- backend

ENVIRONMENT=development

POSTGRES_DB=tws_ecommerce
POSTGRES_USER=tws
POSTGRES_PASSWORD=tws_dev_password
POSTGRES_PORT=5432

REDIS_PORT=56379
API_PORT=58000

DATABASE_URL=postgresql+asyncpg://tws:tws_dev_password@localhost:5432/tws_ecommerce
REDIS_URL=redis://localhost:56379/0

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

JWT_SECRET=replace-me-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-refresh-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

CORS_ORIGINS=http://localhost:3000 , http://localhost:3001 , http://tws.test:3000 , https://tws.test:3000

LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Multi-brand platform. Each store answers at <subdomain>.<PLATFORM_ROOT_DOMAIN>;
# "localhost" works in development because *.localhost resolves to loopback.
PLATFORM_ROOT_DOMAIN=localhost
STOREFRONT_URL_TEMPLATE=http://{subdomain}.{root}:3000
MERCHANT_ACCESS_TOKEN_EXPIRE_MINUTES=30
MERCHANT_REFRESH_TOKEN_EXPIRE_DAYS=14
BRAND_TOKEN_EXPIRE_MINUTES=30

# File storage. "local" = the API's disk, served at /media. "s3" = a bucket
# (the minio service in development), which also enables presigned uploads.
STORAGE_BACKEND=s3
S3_BUCKET=cliq-media
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=cliq_minio
S3_SECRET_ACCESS_KEY=cliq_minio_dev_password
# How the API reaches storage, and how a browser does (used to sign uploads
# and build image URLs). Leave both unset for AWS S3.
S3_ENDPOINT_URL=http://minio:9000
S3_PRESIGN_ENDPOINT_URL=http://localhost:59000
# S3_PUBLIC_BASE_URL=https://cdn.example.com   # optional CDN in front of the bucket
S3_CREATE_BUCKET=true

SEED_TENANT_NAME=CliQ.
SEED_TENANT_SLUG=zeen
SEED_TENANT_DOMAIN=localhost
SEED_ADMIN_PHONE=+919876543210
SEED_ADMIN_EMAIL=admin@zeen.com
SEED_ADMIN_PASSWORD=123

DB_POOL_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_SECONDS=15
PHONE_DEFAULT_COUNTRY_CODE=91
PHONE_NATIONAL_NUMBER_LENGTH=10
# Multi-brand storefronts: the storefront server tells the API which domain the
# shopper visited in X-Forwarded-Host, and its /api/v1 proxy does the same for
# browser calls. Must be true for any brand other than the localhost seed one.
# Safe: a forwarded host can only select a published storefront (as visiting
# that domain would); unpublished stores still need that brand's staff token,
# and brand/customer tokens are checked against the brand they belong to.
TRUST_FORWARDED_HOST=true
LOGIN_IP_RATE_LIMIT_ATTEMPTS=30
OTP_REQUEST_RATE_LIMIT_ATTEMPTS=5
OTP_VERIFY_RATE_LIMIT_ATTEMPTS=10
OTP_IP_RATE_LIMIT_ATTEMPTS=30
OTP_RATE_LIMIT_WINDOW_SECONDS=300
REFRESH_RATE_LIMIT_ATTEMPTS=30

MSG91_AUTH_KEY=your_msg91_auth_key

PAYMENT_PROVIDER=razorpay

# Razorpay Sandbox / Test Credentials
SANDBOX_RAZORPAY_API_KEY=rzp_test_your_key_id
SANDBOX_RAZORPAY_API_SECRET=your_test_key_secret
SANDBOX_RAZORPAY_BASE_URL=https://api.razorpay.com/v1

# Razorpay Production Credentials
PRODUCTION_RAZORPAY_API_KEY=rzp_live_your_live_key_id
PRODUCTION_RAZORPAY_API_SECRET=your_live_key_secret
PRODUCTION_RAZORPAY_BASE_URL=https://api.razorpay.com/v1

# Active Environment (sandbox or production)
RAZORPAY_ENVIRONMENT=sandbox
# Must match the secret on the webhook in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=

# Google sign-in. Leave both empty to hide the button.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Google Sheets order export. Backend only. In Google Cloud: enable the
# Google Sheets API, create a service account, add a JSON key. Paste the key
# here (raw JSON on one line, or base64 of it) -- or mount the file and set
# GOOGLE_SHEETS_SERVICE_ACCOUNT_FILE to its path. Each store then shares its
# spreadsheet with the service account's email (Editor) and connects it under
# Admin > Integrations. The order-sheets worker writes new sales every minute.
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_SERVICE_ACCOUNT_FILE=

# Shiprocket (courier booking, labels, pickups, tracking). Backend only --
# never put these in a NEXT_PUBLIC_ variable. Create an API user in the
# Shiprocket panel: Settings > API > Add New API User (its email must differ
# from the panel login). Empty = integration off. Shiprocket has no separate
# sandbox host: these credentials act on the real account, so a store also
# has to enable booking under Admin > Settings > Shipping provider.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# UUID of the only tenant allowed to use the credentials above.
SHIPROCKET_TENANT_ID=
# Optional JSON map: {"tenant-uuid":{"email":"api@example.com","password":"..."}}
# Use separate API accounts for tenants; server secret only.
SHIPROCKET_TENANT_CREDENTIALS={}
SHIPROCKET_API_URL=https://apiv2.shiprocket.in/v1/external
# Long random string; paste the same value as the webhook "security token"
# in Shiprocket (Settings > API > Webhooks). Empty = webhooks are refused.
SHIPROCKET_WEBHOOK_TOKEN=
# Minutes between tracking re-checks for parcels no webhook has updated.
SHIPMENT_SYNC_INTERVAL_MINUTES=60

# ---------------------------------------------------------------- frontends

# Origin of the CliQ. API, including the /api/v1 prefix.
#
# The backend resolves which tenant a request belongs to from the Host
# header of this URL -- there is no tenant header or parameter. In
# development, a loopback host falls back to the seeded tenant. In
# production this must be a domain registered in the backend's
# tenant_domains table, and the backend's CORS_ORIGINS must list the
# storefront's own origin.
NEXT_PUBLIC_API_URL=http://localhost:58000/api/v1
# Optional: how the storefront server reaches the API on a private network
# (e.g. http://api:8000/api/v1 in Docker). Defaults to NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=

# Admin frontend settings.
NEXT_PUBLIC_AUTH_IDLE_TIMEOUT_MINUTES=30
NEXT_PUBLIC_API_ORIGIN=http://localhost:58000
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000

# Currency for catalogue prices. Orders and coupons carry their own, which
# always wins; this only covers the storefront, where the backend exposes no
# currency of its own. ISO 4217, and it must match the tenant's currency.
NEXT_PUBLIC_CURRENCY=INR

# Fallback origin for canonical URLs/sitemap when there is no request (build
# time). At request time each brand's own domain is used. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://tws.test:3000

# From MSG91 console -> OTP Widget. Both are safe to expose to the browser.
NEXT_PUBLIC_MSG91_WIDGET_ID=366967694e32303435323534
NEXT_PUBLIC_MSG91_TOKEN_AUTH=568032TbBlbK12rwm6a9e8be4P1

# Razorpay public key id -- rzp_test_... in development, rzp_live_... in
# production. It must be the key id of the same account and mode the backend
# uses (RAZORPAY_ENVIRONMENT). Only the key id: the secret never goes here.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# Email (SMTP). Empty SMTP_HOST = emails wait in the outbox (nothing is sent).
# Careful in development: once set, queued test emails go to their real recipients.
# Gmail: smtp.gmail.com / 587 / starttls / your address / a 16-char App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=CliQ.
