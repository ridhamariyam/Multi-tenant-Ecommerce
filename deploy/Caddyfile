# CliQ. production reverse proxy.
#
#   app.<root>       merchant console + platform admin (admin-frontend)
#   api.<root>       API: payment/courier webhooks and /media files
#   media.<root>     object storage (product images, direct uploads) when MinIO is used
#   <root>           redirects to app.<root>
#   anything else    a brand storefront: <brand>.<root> or a verified custom domain
#
# Certificates come from Let's Encrypt. Storefront hosts get theirs on demand
# (first request), but only after the API confirms the host is a real store
# (/api/v1/internal/tls-allowed), so no one can make us request certificates
# for arbitrary names.

{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://api:8000/api/v1/internal/tls-allowed
	}
	# Extra global options, e.g. "local_certs" to test the stack on a laptop.
	{$CADDY_EXTRA_GLOBAL_OPTIONS}
}

(common) {
	encode zstd gzip
	header -Server
	log {
		output stdout
		format json
	}
}

app.{$PLATFORM_ROOT_DOMAIN} {
	import common
	redir / /admin/ 302
	reverse_proxy admin:3001
}

api.{$PLATFORM_ROOT_DOMAIN} {
	import common
	# The API is internal except for webhooks, uploaded media and health.
	@public path /api/v1/payments/razorpay/webhook* /api/v1/billing/razorpay/webhook /api/v1/webhooks/fashn /api/v1/courier-webhooks/* /media/* /health /health/ready
	handle @public {
		request_body {
			max_size 25MB
		}
		reverse_proxy api:8000
	}
	handle {
		respond "Not found" 404
	}
}

media.{$PLATFORM_ROOT_DOMAIN} {
	import common
	request_body {
		max_size 25MB
	}
	# Only presigned POST uploads (bucket root) and single public objects.
	# MinIO's "download" policy also allows listing the bucket, which would
	# expose every brand's keys and pending uploads; that never reaches it.
	@upload {
		path_regexp ^/[^/]+/?$
		method POST
	}
	@object {
		path_regexp ^/[^/]+/.+
		method GET HEAD
		not path_regexp ^/[^/]+/pending/
		expression {http.request.uri.query} == ''
	}
	handle @upload {
		reverse_proxy minio:9000
	}
	handle @object {
		reverse_proxy minio:9000
	}
	handle {
		respond "Not found" 404
	}
}

{$PLATFORM_ROOT_DOMAIN} {
	import common
	redir https://app.{$PLATFORM_ROOT_DOMAIN}{uri} 308
}

https:// {
	import common
	tls {
		on_demand
	}
	request_body {
		max_size 25MB
	}
	reverse_proxy storefront:3000
}
