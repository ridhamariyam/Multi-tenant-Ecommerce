# CliQ. production settings. Copy to .env.production on the server, fill in
# every CHANGE_ME, and keep the file out of git (it is ignored).
# Generate secrets with:  openssl rand -hex 32

ENVIRONMENT=production
# Increment on each deploy to tag images (rollback = previous tag).
CLIQ_VERSION=1

# --- Domain and TLS -------------------------------------------------------
# Brands answer at <brand>.<PLATFORM_ROOT_DOMAIN>; the console at
# app.<root>, the API at api.<root>, media at media.<root>.
# DNS: A/AAAA records for <root> and *.<root> pointing at this server.
PLATFORM_ROOT_DOMAIN=CHANGE_ME.example.com
STOREFRONT_URL_TEMPLATE=https://{subdomain}.{root}
ACME_EMAIL=CHANGE_ME@example.com
# Leave empty in production. "local_certs" only for a laptop test.
CADDY_EXTRA_GLOBAL_OPTIONS=

# --- Database / cache -----------------------------------------------------
POSTGRES_DB=cliq
POSTGRES_USER=cliq
POSTGRES_PASSWORD=CHANGE_ME
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
API_WORKERS=2

# --- Auth (each at least 32 characters, all different) -------------------
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
# Browsers never call the API directly (the storefront and console proxy it).
CORS_ORIGINS=https://app.CHANGE_ME.example.com

# --- Object storage -------------------------------------------------------
STORAGE_BACKEND=s3
S3_BUCKET=cliq-media
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
# Bundled MinIO (internal) and its public address; for AWS S3 / R2 set both
# to the provider's endpoint and remove the minio service.
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_BASE_URL=https://media.CHANGE_ME.example.com/cliq-media

# --- First run: the operator's own store and admin -------------------------
SEED_TENANT_NAME=CliQ.
SEED_TENANT_SLUG=cliq
SEED_TENANT_DOMAIN=cliq.CHANGE_ME.example.com
SEED_ADMIN_EMAIL=CHANGE_ME@example.com
SEED_ADMIN_PHONE=
SEED_ADMIN_PASSWORD=CHANGE_ME

# --- Backups ----------------------------------------------------------------
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=14

# --- Monitoring ---------------------------------------------------------------
# Logs are JSON lines by default in production (LOG_FORMAT=text to read by eye).
LOG_LEVEL=INFO
# Error reporting (sentry.io or self-hosted Sentry/GlitchTip). Empty = logs only.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# Slack / Discord / Google Chat incoming webhook: job failures and a nearly
# full disk are posted here (once per hour per problem). Empty = no alerts.
ALERT_WEBHOOK_URL=
DISK_ALERT_FREE_PERCENT=10

# --- Providers (leave empty until you have accounts) ------------------------
RAZORPAY_ENVIRONMENT=production
PRODUCTION_RAZORPAY_API_KEY=
PRODUCTION_RAZORPAY_API_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
MSG91_AUTH_KEY=
NEXT_PUBLIC_MSG91_WIDGET_ID=
NEXT_PUBLIC_MSG91_TOKEN_AUTH=
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_TENANT_ID=
SHIPROCKET_WEBHOOK_TOKEN=
